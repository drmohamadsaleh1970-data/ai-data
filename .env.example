# --- Runtime ---
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DB_FILE=./data/aihome.db
EXPORT_DIR=./data/exports

# --- Platform owner (recreated from these settings on every start) ---
OWNER_EMAIL=                  # the owner's Google address
OWNER_TOTP_SECRET=            # base32 secret for the authenticator app: npm run owner-mfa-secret -- you@gmail.com

# --- Google Identity Services (OIDC) ---
# OAuth 2.0 Web client ID from Google Cloud Console; add BASE_URL to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# --- PayPal Subscriptions ---
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # from the webhook registered at {BASE_URL}/api/webhooks/paypal

# Meta Lead Ads (Facebook/Instagram instant forms) straight into the portal - docs/HOT_LEADS.md section 5
META_APP_SECRET=              # Meta app secret: checks webhook signatures, encrypts stored Page tokens
META_VERIFY_TOKEN=            # any long random text, typed into the Meta app webhook settings
PAYPAL_PLAN_ID_AGENCY=        # AED 999 / month billing plan
PAYPAL_PLAN_ID_AGENT=         # AED 99 / month billing plan

# --- ai-home.world investor-data source (optional; file import works without it) ---
AIHOME_SOURCE_URL=            # read-only JSON endpoint serving investor-history rows
AIHOME_SOURCE_TOKEN=          # sent as "Authorization: Bearer ..."
AIHOME_SYNC_MINUTES=0         # >0 enables scheduled pulls

# --- Policy ---
BILLING_GRACE_DAYS=0          # days of Cold access after a failed renewal (0 = pause immediately)
MAGIC_LINK_TTL_HOURS=48

# "Sign in as" demo personas with FICTIONAL data. Anyone who opens the site can use them,
# including the demo Platform Owner. On a production host both lines are required.
DEMO_MODE=false
ALLOW_PUBLIC_DEMO=false

# Owner/finance actions need an authenticator code. Set to false to rely on Google sign-in alone.
OWNER_MFA_REQUIRED=true
