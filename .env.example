# --- Runtime ---
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DB_FILE=./data/aihome.db
EXPORT_DIR=./data/exports
# DEMO_MODE enables persona sign-in, the email outbox viewer and the TOTP helper.
# The server refuses to start with DEMO_MODE=true when NODE_ENV=production.
DEMO_MODE=true

# --- Google Identity Services (OIDC) ---
# OAuth 2.0 Web client ID from Google Cloud Console; add BASE_URL to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# --- PayPal Subscriptions ---
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # from the webhook registered at {BASE_URL}/api/webhooks/paypal
PAYPAL_PLAN_ID_AGENCY=        # USD 999 / month billing plan
PAYPAL_PLAN_ID_AGENT=         # USD 99 / month billing plan

# --- ai-home.world investor-data source (optional; file import works without it) ---
AIHOME_SOURCE_URL=            # read-only JSON endpoint serving investor-history rows
AIHOME_SOURCE_TOKEN=          # sent as "Authorization: Bearer ..."
AIHOME_SYNC_MINUTES=0         # >0 enables scheduled pulls

# --- Policy ---
BILLING_GRACE_DAYS=0          # days of Cold access after a failed renewal (0 = pause immediately)
MAGIC_LINK_TTL_HOURS=48
